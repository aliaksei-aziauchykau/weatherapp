# WeatherApp local deploy
COMPOSE_PROJECT_NAME=vs-weatherapp-local
WEATHERAPP_NETWORK_NAME=vs-weatherapp-local-network
WEATHERAPP_DOCKER_PROFILE=local
WEATHERAPP_SERVICES=postgresql,api,ui,gateway
ROOT_WSL_PATH=

# Database (api container)
WEATHER_DB_PASSWORD=ChangeMe_Weather1
WEATHER_DATABASE_CONNECTION_STRING=Host=weatherapp-postgresql;Port=5432;Database=weather;Username=weather;Password=ChangeMe_Weather1

# CORS: browser URL for UI
WEATHER_CORS_ORIGINS=http://ui.weatherapp.local.projects.volnyja-siervisy.site:9080,http://ui.weatherapp.local.projects.volnyja-siervisy.site

# Public API base (UI fetch)
WEATHER_API_PUBLIC_BASE_URL=http://api.weatherapp.local.projects.volnyja-siervisy.site:9080
